# Local demo mode needs nothing below. Everything runs offline with
# deterministic keys derived from the public default seed.
SIGBASH_MODE=local

# REQUIRED before any live-mode command or before funding anything: keys
# derived from the default seed are public knowledge. Live commands refuse to
# run until this is set to a strong random secret.
#VAULT_DEMO_SEED=

# Live Sigbash credentials. Ideally each participant holds their own triplet
# (suffix _ALICE / _BOB / _CAROL); the unsuffixed values are the fallback for
# single-operator demo runs.
SIGBASH_SERVER_URL=https://www.sigbash.com
SIGBASH_API_KEY=
SIGBASH_USER_KEY=
SIGBASH_SECRET_KEY=
#SIGBASH_API_KEY_ALICE=
#SIGBASH_USER_KEY_ALICE=
#SIGBASH_SECRET_KEY_ALICE=
SIGBASH_WASM_URL=https://www.sigbash.com/sigbash.wasm
# Browser runtime supply-chain pins. These values pin the Sigbash-hosted files
# published 2026-08-03; verify and deliberately update both if Sigbash rotates
# its runtime. A mismatch fails closed before any credential or key operation.
SIGBASH_WASM_SHA384=a57fa4c7172fb06dce6133832778247fb22c586d1e2ee70282ff8efa1f0e5b58a81b02dbd1d6b69e474254bc35c6945d
SIGBASH_WASM_EXEC_URL=https://www.sigbash.com/wasm_exec.js
SIGBASH_WASM_EXEC_SHA384=74dd1f0a8a6a8fcbbdba677994bf7c44a0f112367047019cf42c25057f147a1511ec8be50c35dfa5add8ce3403fec718

# Printed by `SIGBASH_MODE=live npm run sigbash-live-setup`:
# one leaf key and one key id per (participant, round-they-could-leave).
#SIGBASH_LEAF_KEYS_JSON='{"alice":{"alicebobcarol":"...","alicebob":"...","alicecarol":"..."},"bob":{...},"carol":{...}}'
#SIGBASH_KEY_ID_ALICE_ALICEBOBCAROL=
#SIGBASH_KEY_ID_ALICE_ALICEBOB=
#SIGBASH_KEY_ID_ALICE_ALICECAROL=
#SIGBASH_KEY_ID_BOB_ALICEBOBCAROL=
#SIGBASH_KEY_ID_BOB_ALICEBOB=
#SIGBASH_KEY_ID_BOB_BOBCAROL=
#SIGBASH_KEY_ID_CAROL_ALICEBOBCAROL=
#SIGBASH_KEY_ID_CAROL_ALICECAROL=
#SIGBASH_KEY_ID_CAROL_BOBCAROL=

# Override the recovery timelock (blocks). The inherited default of 6 is only
# for offline acceptance; choose and review a production mainnet value before
# any funding gate can pass.
#RECOVERY_DELAY_BLOCKS=6

# Required before a user-facing roster can be published. Set this to the
# maximum per-person deposit the private beta is allowed to commit, and keep
# VAULT_DEPOSIT_SATS at or below it.
#PRIVATE_BETA_MAX_DEPOSIT_SATS=

BITCOIN_RPC_URL=http://127.0.0.1:8332
BITCOIN_RPC_USER=
BITCOIN_RPC_PASSWORD=

# Passkey web service. Production requires HTTPS and exact RP values.
DATABASE_URL=
WEBAUTHN_RP_NAME=Bitcoin Multiplayer Vault
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3000
# Base URL included in invite links. Use the same HTTPS origin in production.
APP_ORIGIN=http://localhost:3000
# Comma-separated browser-facing chain sources. These must be HTTPS origins
# independent from this service; every signer authenticates the exact UTXO
# snapshot they observed before any signing step is enabled.
CHAIN_OBSERVATION_ORIGINS=https://mempool.space
